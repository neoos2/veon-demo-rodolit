---
import { Picture } from "astro:assets";
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { contacts, FUTURE_NOTE } from "../data/site";
import irex from "../assets/letters/irex-urrf-recommendation-page-1.jpg";
import mvs from "../assets/letters/mvs-chernihiv-review-page-1.jpg";
import khc from "../assets/letters/humanitarian-coordination-centre-review-page-1.jpg";
import irc from "../assets/letters/international-rescue-committee-review-page-1.jpg";
import bereh from "../assets/letters/bereh-nadii-recommendation-page-1.jpg";
import gc from "../assets/letters/global-communities-recommendation-page-1.jpg";

// Organisations and scans from the «Відгуки та рекомендації» block of the client's homepage (16.11.2026).
const letters = [
  { org: "IREX / Ukrainian Rapid Response Fund", img: irex },
  { org: "ТМО МВС України по Чернігівській області", img: mvs },
  { org: "Координаційний гуманітарний центр", img: khc },
  { org: "International Rescue Committee", img: irc },
  { org: "Реабілітаційний центр «Берег надії», Хмельницька міська рада", img: bereh },
  { org: "Global Communities Ukraine", img: gc },
];
const partners = ["Aton", "Bioned", "Diameb Trade", "Granum", "HLR", "Medigran", "Medrehab", "Viola"];
const importers = ["Guangzhou Longest Medical Technology", "Xiangyu Medical", "Xuzhou Yongkang Electronic Science Technology", "United Surgical Industries"];
---
<Section id="trust" rec="R-UX-006" class="trust">
  <div class="container">
    <div class="trust__grid">
      <div class="trust__side">
        <div class="section-head">
          <h2>Листи та реквізити</h2>
          <p>Рекомендаційні листи державних установ і міжнародних організацій, яким ми постачали обладнання.</p>
        </div>

        <dl class="blank" aria-label="Реквізити постачальника">
          <div><dt>Постачальник</dt><dd>{contacts.legalName}</dd></div>
          <div><dt>Код ЄДРПОУ</dt><dd class="num">{contacts.edrpou}</dd></div>
          <div><dt>Податки</dt><dd>Платник ПДВ</dd></div>
          <div><dt>Адреса</dt><dd>{contacts.address}</dd></div>
          <div><dt>Документи</dt><dd>Сертифікати та декларації відповідності надаємо при купівлі та для тендерів</dd></div>
        </dl>
      </div>

      <div class="binder" data-binder>
        <div class="binder__nav">
        <ol class="binder__list">
          {letters.map((l, i) => (
            <li>
              <button type="button" class="binder__item" aria-pressed={i === 0 ? "true" : "false"} data-letter={i}>
                <span class="binder__n num">{String(i + 1).padStart(2, "0")}</span>
                <span class="binder__org">{l.org}</span>
              </button>
            </li>
          ))}
        </ol>
        <FutureLink note={FUTURE_NOTE} class="fl-quiet binder__all">Усі листи й сертифікати</FutureLink>
        </div>
        <div class="binder__stage">
          {letters.map((l, i) => (
            <figure class:list={["binder__sheet", i === 0 && "is-active"]} data-sheet={i} aria-hidden={i === 0 ? undefined : "true"}>
              <Picture src={l.img} formats={["avif", "webp"]} widths={[360, 540, 720]} sizes="(min-width: 64em) 30vw, 85vw" alt={`Рекомендаційний лист: ${l.org}, сторінка 1`} loading="lazy" decoding="async" />
              <figcaption class="cap">{l.org}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>

    <div class="makers">
      <p class="makers__label">Партнери</p>
      <p class="makers__list">{partners.join(", ")}</p>
      <p class="makers__label">Імпортуємо від виробників</p>
      <p class="makers__list">{importers.join(", ")}</p>
      <p class="makers__label">Виставка</p>
      <p class="makers__list">Учасник PUBLIC HEALTH 2025, 34-ї Міжнародної медичної виставки, Київ, 1–3 жовтня 2025 року</p>
      <FutureLink note={FUTURE_NOTE} class="fl-quiet makers__more">Виробники</FutureLink>
    </div>
  </div>
</Section>

<style is:global>
  .trust { padding-block: var(--space-section) var(--space-section-sm); }
  .trust__grid { display: grid; gap: var(--space-7); }
  .trust__side { display: grid; gap: var(--space-6); align-content: start; }

  .blank { margin: 0; border-top: var(--rule-w) solid var(--color-text); }
  .blank > div { display: grid; gap: var(--space-1); padding-block: var(--space-3); border-bottom: var(--rule-w) solid var(--color-rule); }
  .blank dt { font-size: var(--fs-cap); color: var(--color-muted); }
  .blank dd { margin: 0; font-weight: 700; }

  .binder { display: grid; gap: var(--space-5); align-content: start; }
  .binder__list { border-top: var(--rule-w) solid var(--color-text); }
  .binder__item {
    position: relative; display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-3); align-items: baseline;
    width: 100%; min-height: 3rem; padding: var(--space-3) 0; margin: 0;
    background: none; border: 0; border-bottom: var(--rule-w) solid var(--color-rule);
    font: 400 var(--fs-body)/1.35 var(--font-body); color: var(--color-text); text-align: left; cursor: pointer;
  }
  .binder__item::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: calc(-1 * var(--rule-w)); height: var(--rule-w);
    background: var(--color-accent); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-line) var(--ease-out);
  }
  .binder__item:hover::after, .binder__item:focus-visible::after, .binder__item[aria-pressed="true"]::after { transform: scaleX(1); }
  .binder__item[aria-pressed="true"] .binder__org { font-weight: 700; }
  .binder__item[aria-pressed="true"] .binder__n { color: var(--color-accent); }
  .binder__n { font-size: var(--fs-cap); color: var(--color-muted); }

  .binder__stage { display: grid; max-width: 26rem; }
  .binder__sheet { grid-area: 1 / 1; margin: 0; display: grid; gap: var(--space-2); opacity: 0; visibility: hidden; transition: opacity var(--dur-swap) var(--ease-out), visibility 0s linear var(--dur-swap); }
  .binder__sheet.is-active { opacity: 1; visibility: visible; transition: opacity var(--dur-swap) var(--ease-out), visibility 0s; }
  .binder__sheet img { width: 100%; height: auto; background: var(--color-plate); box-shadow: var(--shadow-sheet); }
  .binder__nav { display: grid; gap: var(--space-4); align-content: start; }
  .binder__all { justify-self: start; }

  .makers { display: grid; gap: var(--space-1) var(--gutter); margin-top: var(--space-8); padding-top: var(--space-5); border-top: var(--rule-w) solid var(--color-rule); }
  .makers__label { font-size: var(--fs-cap); color: var(--color-muted); }
  .makers__list { margin-bottom: var(--space-4); }
  .makers__more { justify-self: start; }

  @media (min-width: 48em) {
    .binder { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-6); }
    .binder__stage { align-self: start; }
    .makers { grid-template-columns: 16rem minmax(0, 1fr); }
    .makers__list { margin-bottom: var(--space-3); }
    .makers__more { grid-column: 2; }
  }
  @media (min-width: 64em) {
    .trust__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .trust__side { grid-column: 1 / span 4; }
    .binder { grid-column: 6 / span 7; }
  }
  @media (prefers-reduced-motion: reduce) {
    .binder__sheet, .binder__sheet.is-active, .binder__item::after { transition: none; }
  }
</style>

<script>
  const binder = document.querySelector<HTMLElement>("[data-binder]");
  if (binder) {
    const items = Array.from(binder.querySelectorAll<HTMLButtonElement>("[data-letter]"));
    const sheets = Array.from(binder.querySelectorAll<HTMLElement>("[data-sheet]"));
    const show = (i: number) => {
      items.forEach((b, k) => b.setAttribute("aria-pressed", String(k === i)));
      sheets.forEach((s, k) => {
        s.classList.toggle("is-active", k === i);
        if (k === i) s.removeAttribute("aria-hidden"); else s.setAttribute("aria-hidden", "true");
        if (k === i) s.querySelector("img")?.setAttribute("loading", "eager");
      });
    };
    const fine = window.matchMedia("(hover: hover)");
    items.forEach((b, i) => {
      b.addEventListener("click", () => show(i));
      b.addEventListener("focus", () => show(i));
      b.addEventListener("mouseenter", () => { if (fine.matches) show(i); });
    });
  }
</script>
