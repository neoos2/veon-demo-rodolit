---
// Functional line icons, 1.5px stroke, currentColor. Decorative: always paired with visible text or an aria-label on the parent.
type Name = "phone" | "viber" | "telegram" | "mail" | "arrow" | "search" | "instagram" | "youtube" | "menu" | "close" | "chevron";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M6.6 3.5h-2a1.5 1.5 0 0 0-1.5 1.6c.6 8.2 7.6 15.2 15.8 15.8a1.5 1.5 0 0 0 1.6-1.5v-2a1.5 1.5 0 0 0-1.1-1.4l-3-.9a1.5 1.5 0 0 0-1.5.4l-1.2 1.2a12 12 0 0 1-5.4-5.4l1.2-1.2a1.5 1.5 0 0 0 .4-1.5l-.9-3A1.5 1.5 0 0 0 6.6 3.5Z" />}
  {name === "viber" && <><path d="M12 3c-4.6 0-8 1.6-8 7.3 0 3.3 1.1 5.2 3 6.2V20l2.8-2.6c.7.1 1.4.1 2.2.1 4.6 0 8-1.6 8-7.2S16.6 3 12 3Z" /><path d="M9.6 7.8c.3-.3.8-.3 1 .1l.6 1c.2.3.1.7-.2.9l-.4.3c.4 1 1.2 1.8 2.2 2.2l.3-.4c.2-.3.6-.4.9-.2l1 .6c.4.2.4.7.1 1l-.5.5c-.4.4-1 .5-1.5.3a7 7 0 0 1-4-4c-.2-.5-.1-1.1.3-1.5Z" /></>}
  {name === "telegram" && <><path d="m21 4-18 7.2 6 2.2L19 6.5l-7.9 8.4L17.5 20 21 4Z" /><path d="M9 13.4V19l3-3.1" /></>}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "arrow" && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === "chevron" && <path d="m6 9 6 6 6-6" />}
  {name === "search" && <><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></>}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8h.01" /></>}
  {name === "youtube" && <><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" /><path d="m10 9.2 5 2.8-5 2.8Z" /></>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
</svg>
